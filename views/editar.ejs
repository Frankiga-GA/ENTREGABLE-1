<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Producto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container mt-5">
    <h1 class="text-center mb-4">Editar Producto</h1>
    <form action="/editar/<%= producto.idproducto %>" method="post" enctype="multipart/form-data" class="bg-white p-4 rounded shadow">
        <div class="mb-3">
            <label class="form-label">Categoría:</label>
            <select name="idcategoria" class="form-select">
                <% categorias.forEach(cat => { %>
                    <option value="<%= cat.idcategoria %>" <%= producto.idcategoria == cat.idcategoria ? 'selected' : '' %>><%= cat.nombre %></option>
                <% }) %>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Nombre:</label>
            <input type="text" name="nombre" value="<%= producto.nombre %>" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción:</label>
            <textarea name="descripcion" class="form-control"><%= producto.descripcion %></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Precio:</label>
            <input type="text" name="precio" value="<%= producto.precio %>" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Stock:</label>
            <input type="number" name="stock" value="<%= producto.stock %>" class="form-control">
        </div>
        <div class="mb-3">
            <label class="form-label">Imagen Actual 1:</label><br>
            <img src="/img/<%= producto.imagen1 %>" width="100">
            <input type="hidden" name="imagen1_actual" value="<%= producto.imagen1 %>">
            <input type="file" name="imagen1" class="form-control mt-2">
        </div>
        <div class="mb-3">
            <label class="form-label">Imagen Actual 2:</label><br>
            <img src="/img/<%= producto.imagen2 %>" width="100">
            <input type="hidden" name="imagen2_actual" value="<%= producto.imagen2 %>">
            <input type="file" name="imagen2" class="form-control mt-2">
        </div>
        <div class="text-center">
            <button type="submit" class="btn btn-success">Guardar Cambios</button>
            <a href="/catalogo" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
</body>
</html>
